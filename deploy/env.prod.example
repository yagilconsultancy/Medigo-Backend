# ===========================================
# MediRide Production Environment
# ===========================================
# Copy to .env on the production server
# ALL values marked CHANGE-ME must be replaced

ENVIRONMENT=production
LOG_LEVEL=WARNING
DEFAULT_TIMEZONE=Canada/Eastern

# JWT — generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE-ME-TO-A-RANDOM-64-CHAR-STRING
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== AWS RDS ====================
RDS_HOST=CHANGE-ME.xxxxxxxxxx.ca-central-1.rds.amazonaws.com
RDS_PORT=5432
RDS_USERNAME=mediride
RDS_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# ==================== AWS S3 ====================
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=CHANGE-ME
AWS_SECRET_ACCESS_KEY=CHANGE-ME
S3_BUCKET_DOCUMENTS=mediride-documents

# ==================== RabbitMQ ====================
RABBITMQ_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# ==================== Redis ====================
REDIS_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# ==================== OTP ====================
OTP_EXPIRE_MINUTES=5

# ==================== Google Maps ====================
GOOGLE_MAPS_API_KEY=CHANGE-ME

# Sign in with Google / Apple (comma separated client ids; empty = that provider is off)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ==================== Stripe ====================
STRIPE_SECRET_KEY=sk_live_CHANGE-ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE-ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE-ME

# ==================== Email (Mailgun SMTP) ====================
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=noreply@mail.getmedigo.com
SMTP_PASSWORD=CHANGE-ME
SMTP_STARTTLS=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=30
EMAIL_FROM=noreply@mail.getmedigo.com
PARTNERS_EMAIL_FROM=partners@mail.getmedigo.com
PARTNERS_EMAIL_REPLY_TO=partners@mail.getmedigo.com
PARTNERS_SMTP_USERNAME=partners@mail.getmedigo.com
PARTNERS_SMTP_PASSWORD=CHANGE-ME

# ==================== Rate Limiting ====================
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
# Per-visitor limits on public endpoints (sign-in, codes, public forms). true or false.
RATE_LIMIT_ENABLED=true
# Websites allowed to call the API from a browser, comma separated. * = any website.
CORS_ORIGINS=*

# ==================== Docker ====================
IMAGE_TAG=latest

# ==================== Internal service calls ====================
# Shared secret the backend services send to each other.
# Generate on the server without printing it:
#   printf 'INTERNAL_SERVICE_TOKEN=%s\n' "$(openssl rand -hex 32)" >> .env
# log = warn about calls without the secret (default), enforce = block them, off = old behaviour.
INTERNAL_AUTH_MODE=log
