# ===========================================
# MediRide Staging Environment
# ===========================================
# Copy to .env on the staging server

ENVIRONMENT=staging
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=America/Toronto

# JWT - CHANGE THIS!
JWT_SECRET_KEY=CHANGE-ME-TO-A-RANDOM-64-CHAR-STRING
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL (single instance, all databases)
POSTGRES_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# RabbitMQ
RABBITMQ_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# Redis
REDIS_PASSWORD=CHANGE-ME-STRONG-PASSWORD
REDIS_URL=redis://:CHANGE-ME-STRONG-PASSWORD@redis:6379/0

# OTP
OTP_EXPIRE_MINUTES=5

# Google Maps API
GOOGLE_MAPS_API_KEY=

# Stripe Payment Gateway
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MOCK_IN_DEVELOPMENT=false

# S3-Compatible Storage (MinIO on staging)
S3_ACCESS_KEY=CHANGE-ME-STRONG-KEY
S3_SECRET_KEY=CHANGE-ME-STRONG-SECRET
S3_BUCKET_DOCUMENTS=mediride-documents

# Email (ZeptoMail / Zoho SMTP)
SMTP_HOST=smtp.zeptomail.ca
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=30
EMAIL_FROM=noreply@getmedigo.com

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
