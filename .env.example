# ===========================================
# MediRide Environment Configuration
# ===========================================
# Copy this file to .env and fill in values

ENVIRONMENT=development
LOG_LEVEL=INFO

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Passwords (per service)
POSTGRES_AUTH_PASSWORD=dev_password
POSTGRES_USERS_PASSWORD=dev_password
POSTGRES_RIDES_PASSWORD=dev_password
POSTGRES_LOCATIONS_PASSWORD=dev_password
POSTGRES_PAYMENTS_PASSWORD=dev_password
POSTGRES_TRACKING_PASSWORD=dev_password

# RabbitMQ
RABBITMQ_PASSWORD=dev_password

# Redis
REDIS_URL=redis://redis:6379/0

# OTP
OTP_EXPIRE_MINUTES=5

# Geocoding (Phase 3)
GEOCODING_API_KEY=
GEOCODING_PROVIDER=google

# Stripe (Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MOCK_IN_DEVELOPMENT=true

# Email (AWS SES)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
EMAIL_FROM=noreply@mediride.com

# Twilio (Phase 3)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
